# CoachCRM — Environment variables template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
#
# Values are obtained from the Supabase dashboard:
#   https://supabase.com/dashboard/project/<your-project-id>/settings/api-keys
#
# CoachCRM uses Supabase's NEW publishable/secret key model (sb_publishable_*,
# sb_secret_*). The legacy anon/service_role JWTs are disabled. If you still
# see VITE_SUPABASE_ANON_KEY anywhere, it is stale and should be replaced.

VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Auth hardening (P1-O)
# Canonical application URL used as the OAuth redirectTo target.
# Must match an entry in your Supabase project's "Redirect URLs" allowlist.
# Falls back to window.location.origin if unset (not recommended in production).
VITE_APP_URL=https://your-production-domain.com

# When set, the Google OAuth flow passes hd=<domain> to restrict sign-in to
# users of a specific Google Workspace organisation.
# Example: VITE_GOOGLE_WORKSPACE_DOMAIN=kotech.ai
VITE_GOOGLE_WORKSPACE_DOMAIN=
