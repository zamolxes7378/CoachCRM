# CoachCRM — Environment variables template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
#
# Values are obtained from the Supabase dashboard:
#   https://supabase.com/dashboard/project/<your-project-id>/settings/api-keys
#
# CoachCRM uses Supabase's NEW publishable/secret key model (sb_publishable_*,
# sb_secret_*). The legacy anon/service_role JWTs are disabled. If you still
# see VITE_SUPABASE_ANON_KEY anywhere, it is stale and should be replaced.

VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
